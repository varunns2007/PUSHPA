# Copy to .env.local and fill in real values.
# The app runs fully in DEMO MODE with no keys set.

VITE_SATELLITE_API_URL=
# Get a free-tier key: console.cloud.google.com -> new project -> enable
# "Maps JavaScript API" -> Credentials -> Create API key -> restrict it to
# your domain(s) and to the Maps JavaScript API. Paste it below. Without
# this, everything still works — the Vehicles tab's "Live Map (Google)"
# mode just shows a placeholder instead of the real basemap.
VITE_GOOGLE_MAPS_API_KEY=
VITE_BACKEND_URL=

# ---------------------------------------------------------------------------
# Backend (copy the block below into backend/.env — these are read by
# python-dotenv/os.getenv in the FastAPI app, not by Vite).
# ---------------------------------------------------------------------------

# USE_LIVE_SATELLITE=1 switches from synthetic demo imagery to real
# Sentinel-2 satellite passes via Microsoft Planetary Computer (free,
# no paid key required — see backend/app/satellite/live_client.py).
# Leave at 0/unset to stay in zero-setup demo mode.
# USE_LIVE_SATELLITE=0

# Optional: a free Planetary Computer subscription key raises the request
# rate limit. Not required to get real imagery — sign up at
# https://planetarycomputer.microsoft.com/account/request if you hit limits.
# PC_SDK_SUBSCRIPTION_KEY=

# How often the automatic daily/periodic satellite watch re-checks every
# forest zone, in hours. 24 = once a day.
# WATCH_INTERVAL_HOURS=24

# Set to 0 to disable the background watch entirely (on-demand API calls
# still work; nothing runs on a timer).
# WATCH_ENABLED=1

# Canopy-density drop percentage (zone-wide average) that triggers an
# automatic alert during a watch cycle.
# WATCH_ALERT_THRESHOLD_PCT=15

# Comma-separated zone IDs to watch, e.g. "ZONE-A,ZONE-B". Leave unset to
# watch every zone in app/database/store.py.
# WATCH_ZONE_IDS=

# How many days back the very first watch cycle compares against, before
# it has a prior run of its own to compare to.
# WATCH_LOOKBACK_DAYS=10

# --- Police dispatch (app/police/) -----------------------------------------
# How far (km) to search for police stations around an incident before
# giving up on notifying anyone.
# POLICE_DISPATCH_RADIUS_KM=25

# Max number of stations notified per alert.
# POLICE_DISPATCH_LIMIT=3

# 0 (default) = simulated dispatch only, logged and shown in the UI, no
# real messages sent. Set to 1 only after wiring a real SMS/email
# transport into app/police/dispatch.py's _send_live().
# POLICE_DISPATCH_LIVE=0
