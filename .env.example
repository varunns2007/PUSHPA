# PUSHPA Environment Variables

# Server Config
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database Configuration (PostgreSQL + PostGIS or local SQLite fallback)
DATABASE_URL=sqlite:///./pushpa.db

# Satellite APIs (Copernicus Data Space / Sentinel Hub)
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here

# Maps Integration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Risk Scoring Config
NDVI_NON_VEG_THRESHOLD=0.20
NDVI_SPARSE_THRESHOLD=0.40
NDVI_MODERATE_THRESHOLD=0.60
NDVI_CRITICAL_CHANGE_THRESHOLD=-0.35

# Simulation Mode
SIMULATION_MODE=True
SIMULATION_INTERVAL_SEC=3
